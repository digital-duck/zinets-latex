# Copy to .env (git-ignored). The environment overrides this file.
# Folder holding u<hex>.png pictures (also .jpg/.pdf/.svg), one per character; uXXXX is the code point (日 = u65e5.png)
ZITEX_PICT_DIR=data/ele_chars
# Fixed size of every pict in \zimath[pict]: pictures are scaled to fit, keeping their shape
ZITEX_PICT_HEIGHT=1.8em
ZITEX_PICT_WIDTH=1.8em
# Meaning phrases in the grid wrap at this width and show at most this many '/'-separated senses (0 = all)
ZITEX_MEANING_WIDTH=6em
ZITEX_MEANING_SENSES=3
# Colour emoji font used to draw an emoji pict into a picture (XeLaTeX cannot print colour emoji)
# ZITEX_EMOJI_FONT=/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf
